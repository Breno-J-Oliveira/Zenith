{
  "build": {
    "distDir": "../out",
    "devPath": "http://localhost:3001",
    "withGlobalTauri": false,
    "beforeBuildCommand": "cd .. && npm run build",
    "beforeDevCommand": "cd .. && npm run dev"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "msi",
      "identifier": "com.zenith.app",
      "publisher": "Breno J. Oliveira",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/256x256.png",
        "icons/512x512.png"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' http: https:; frame-src 'self' http: https:"
    },
    "windows": [
      {
        "title": "Zenith",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "webview": {
          "devtools": true
        }
      }
    ]
  }
}
