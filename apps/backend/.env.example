# ─── Database (Prisma) ─────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Google Gemini (IA) ──────────────────────────────────────────
# Opcional. Sem a key, o backend usa o MockAIProvider como fallback automático.
# Obter uma key em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# ─── Porta do Backend ────────────────────────────────────────────
PORT=3002

# ─── NexusAuth (apps/auth-service) ──────────────────────────────
# URL do serviço de autenticação NexusAuth.
NEXUS_AUTH_URL=http://localhost:3000

# Issuer esperado nos JWTs do NexusAuth (validado pelo JwksService).
NEXUS_JWT_ISSUER=nexusauth

# ⚠️ APENAS PARA DESENVOLVIMENTO / DEMO ⚠️
# Quando true, o JwksService NÃO valida a assinatura do JWT — apenas
# extrai o payload. Permite testar o frontend sem precisar de PostgreSQL+Redis.
# NUNCA defina como true em produção.
NEXUS_AUTH_SKIP_VALIDATION=false
